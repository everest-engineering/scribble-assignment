# Backend environment configuration (optional — sane defaults are built in).
# The backend reads these from the process environment directly; there is no
# dotenv dependency, so either export them in your shell, prefix the dev command
# (e.g. `PORT=3001 npm run dev`), or run with Node's loader: `node --env-file=.env`.

# Port the API listens on (default 3001 — the frontend expects this).
PORT=3001

# Host/interface to bind (default 0.0.0.0).
HOST=0.0.0.0
